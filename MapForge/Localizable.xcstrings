    "Declare the Grid first: distances are measured in squares.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege zuerst das Raster fest: Entfernungen werden in Quadraten gemessen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δηλώστε πρώτα το πλέγμα: οι αποστάσεις μετρώνται σε τετράγωνα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero declara la cuadrícula: las distancias se miden en casillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclarez d’abord la grille : les distances se mesurent en cases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima dichiara la griglia: le distanze si misurano in quadretti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare a grade primeiro: as distâncias são medidas em quadrados."
          }
        }
      }
    },
