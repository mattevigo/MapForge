            "state": "translated",
            "value": "Rolar iniciativa e devolver à ordem"
          }
        }
      }
    },
    "Roll Initiative for everyone on the Map and begin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Initiative für alle auf der Karte würfeln und beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρίψη Initiative για όλους στον χάρτη και έναρξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar iniciativa para todos los que están en el mapa y empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer l’Initiative pour tous ceux qui sont sur la carte et commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
