    "%@ rolls Initiative when an Encounter starts. Click to leave them out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ würfelt Initiative, wenn eine Begegnung beginnt. Klicke, um sie auszulassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ρίχνει Initiative όταν ξεκινά μια συνάντηση. Κάντε κλικ για εξαίρεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tira iniciativa cuando empieza un encuentro. Haz clic para que no participe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lance l’Initiative au début d’une rencontre. Cliquez pour l’exclure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tira l'iniziativa quando inizia un incontro. Fai clic per escludere questa pedina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rola iniciativa quando um encontro começa. Clique para deixar de fora."
          }
        }
      }
    },
    "%@ sits the next Encounter out. Click to put them in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ setzt bei der nächsten Begegnung aus. Klicke, um sie aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ μένει εκτός της επόμενης συνάντησης. Κάντε κλικ για συμμετοχή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no participa en el próximo encuentro. Haz clic para que participe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne participe pas à la prochaine rencontre. Cliquez pour l’inclure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salta il prossimo incontro. Fai clic per includere questa pedina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fica de fora do próximo encontro. Clique para incluir."
          }
        }
      }
    },
