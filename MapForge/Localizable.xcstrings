    "A Creature or a Treasure emits no Light and is hidden from players by darkness.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kreatur oder ein Schatz sendet kein Licht aus und wird durch Dunkelheit vor den Spielern verborgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πλάσμα ή ένας θησαυρός δεν εκπέμπει φως και κρύβεται από τους παίκτες στο σκοτάδι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una criatura o un tesoro no emite luz y la oscuridad lo oculta a los jugadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une créature ou un trésor n’émet aucune lumière et l’obscurité le cache aux joueurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una creatura o un tesoro non emette luce e l'oscurità lo nasconde ai giocatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma criatura ou um tesouro não emite luz e fica oculto dos jogadores pela escuridão."
          }
        }
      }
    },
    "A Pawn that becomes %@ arrives whole: %@ becomes %@. Conditions and temporary hit points are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Spielfigur, die zu %1$@ wird, kommt unversehrt an: Aus %2$@ wird %3$@. Zustände und temporäre Trefferpunkte bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πιόνι που γίνεται %1$@ αποκαθίσταται πλήρως: τα HP από %2$@ γίνονται %3$@. Τα Conditions και τα temporary hit points διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A Pawn that becomes %1$@ arrives whole: %2$@ becomes %3$@. Conditions and temporary hit points are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ficha que se convierte en %1$@ llega ilesa: %2$@ pasa a ser %3$@. Se conservan los estados y los puntos de golpe temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pion qui devient %1$@ arrive indemne : %2$@ devient %3$@. Les états et les points de vie temporaires sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pedina che diventa %1$@ arriva in piena forma: i punti ferita passano da %2$@ a %3$@. Le condizioni e i punti ferita temporanei restano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma peça que se torna %1$@ chega inteira: os pontos de vida passam de %2$@ para %3$@. As condições e os pontos de vida temporários são mantidos."
          }
        }
      }
    },
    "A Session records into the Workspace. Open one first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung zeichnet in den Arbeitsbereich auf. Öffne zuerst einen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια συνεδρία καταγράφεται στον χώρο εργασίας. Ανοίξτε πρώτα έναν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión se registra en el espacio de trabajo. Abre uno primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session s’enregistre dans l’espace de travail. Ouvrez-en un d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione si registra nell'area di lavoro. Aprine prima una."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão é registrada no espaço de trabalho. Abra um primeiro."
          }
        }
      }
    },
