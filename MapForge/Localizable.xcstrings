    "This workspace was made by a newer version of MapForge (format %lld). Update MapForge to open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich wurde mit einer neueren Version von MapForge erstellt (Format %lld). Aktualisiere MapForge, um ihn zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο χώρος εργασίας δημιουργήθηκε από νεότερη έκδοση του MapForge (μορφή %lld). Ενημερώστε το MapForge για να τον ανοίξετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo se creó con una versión más reciente de MapForge (formato %lld). Actualiza MapForge para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail a été créé par une version plus récente de MapForge (format %lld). Mettez MapForge à jour pour l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest'area di lavoro è stata creata da una versione più recente di MapForge (formato %lld). Aggiorna MapForge per aprirla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espaço de trabalho foi criado por uma versão mais recente do MapForge (formato %lld). Atualize o MapForge para abri-lo."
          }
        }
      }
    },
    "Tick them in the Scene tab.": {
