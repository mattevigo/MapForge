        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τι θα προσθέσετε και κάντε κλικ στον χάρτη για να το τοποθετήσετε. Το Esc ακυρώνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué añadir y haz clic en el mapa para colocarlo. Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quoi ajouter, puis cliquez sur la carte pour le placer. Esc annule."
