    "An Encounter is running on %@. Switching Workspaces will end it. The Combat Log is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ läuft eine Begegnung. Ein Wechsel des Arbeitsbereichs beendet sie. Das Kampfprotokoll bleibt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια συνάντηση είναι σε εξέλιξη στον χάρτη %@. Η αλλαγή χώρου εργασίας θα την τερματίσει. Το αρχείο μάχης διατηρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un encuentro en curso en %@. Cambiar de espacio de trabajo lo terminará. El registro de combate se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une rencontre est en cours sur %@. Changer d’espace de travail y mettra fin. Le journal de combat est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso un incontro su %@. Cambiare area di lavoro lo terminerà. Il log di combattimento viene conservato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um encontro em andamento em %@. Trocar de espaço de trabalho vai encerrá-lo. O registro de combate é mantido."
          }
        }
      }
    },
    "An Encounter is running. Switching Workspaces will end it. The Combat Log is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Begegnung läuft. Ein Wechsel des Arbeitsbereichs beendet sie. Das Kampfprotokoll bleibt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια συνάντηση είναι σε εξέλιξη. Η αλλαγή χώρου εργασίας θα την τερματίσει. Το αρχείο μάχης διατηρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un encuentro en curso. Cambiar de espacio de trabajo lo terminará. El registro de combate se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une rencontre est en cours. Changer d’espace de travail y mettra fin. Le journal de combat est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso un incontro. Cambiare area di lavoro lo terminerà. Il log di combattimento viene conservato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um encontro em andamento. Trocar de espaço de trabalho vai encerrá-lo. O registro de combate é mantido."
          }
        }
      }
    },
    "An encounter is running and ending the session will end it too. Both logs are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Begegnung läuft. Wenn du die Sitzung beendest, endet auch sie. Beide Protokolle bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια συνάντηση είναι σε εξέλιξη και ο τερματισμός της συνεδρίας θα την τερματίσει κι αυτήν. Διατηρούνται και τα δύο αρχεία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un encuentro en curso y terminar la sesión también lo terminará. Se conservan ambos registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une rencontre est en cours ; terminer la session y mettra fin aussi. Les deux journaux sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in corso un incontro: terminare la sessione terminerà anche quello. Entrambi i log vengono conservati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um encontro em andamento, e encerrar a sessão vai encerrá-lo também. Os dois registros são mantidos."
          }
        }
      }
    },
    "An encounter is running on %@ and ending the session will end it too. Both logs are kept.": {
      "localizations": {
        "de": {
