      }
    },
    "MapForge couldn't set that folder up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge konnte diesen Ordner nicht einrichten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MapForge δεν μπόρεσε να ρυθμίσει αυτόν τον φάκελο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge no ha podido configurar esa carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge n’a pas pu configurer ce dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge non è riuscito a configurare quella cartella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MapForge não conseguiu configurar essa pasta."
          }
        }
      }
    },
    "MapForge hasn't changed the file at %@. Changes made here won't be saved until it's fixed or moved aside.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge hat die Datei unter %@ nicht verändert. Änderungen hier werden erst gesichert, wenn sie repariert oder verschoben wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MapForge δεν έχει αλλάξει το αρχείο στη θέση %@. Οι αλλαγές που γίνονται εδώ δεν θα αποθηκευτούν μέχρι να διορθωθεί ή να μετακινηθεί αλλού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge no ha modificado el archivo en %@. Los cambios que hagas aquí no se guardarán hasta que se repare o se mueva a otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge n’a pas modifié le fichier situé à %@. Ce que vous modifiez ici ne sera pas enregistré tant qu’il n’aura pas été réparé ou déplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge non ha modificato il file in %@. Le modifiche fatte qui non verranno salvate finché non sarà riparato o spostato altrove."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MapForge não alterou o arquivo em %@. O que você mudar aqui não será salvo até que ele seja corrigido ou tirado do lugar."
          }
        }
      }
    },
    "MapForge hasn't changed the roster file. Changes made here won't be saved until it's fixed or moved aside.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge hat die Datei der Gruppenliste nicht verändert. Änderungen hier werden erst gesichert, wenn sie repariert oder verschoben wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MapForge δεν έχει αλλάξει το αρχείο του καταλόγου. Οι αλλαγές που γίνονται εδώ δεν θα αποθηκευτούν μέχρι να διορθωθεί ή να μετακινηθεί αλλού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge no ha modificado el archivo de la lista. Los cambios que hagas aquí no se guardarán hasta que se repare o se mueva a otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge n’a pas modifié le fichier de la liste des groupes. Ce que vous modifiez ici ne sera pas enregistré tant qu’il n’aura pas été réparé ou déplacé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge non ha modificato il file dei gruppi. Le modifiche fatte qui non verranno salvate finché non sarà riparato o spostato altrove."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MapForge não alterou o arquivo da lista de grupos. O que você mudar aqui não será salvo até que ele seja corrigido ou tirado do lugar."
          }
        }
      }
    },
    "MapForge opens Maps from inside your Workspace, “%@”, and keeps each Map's Walls, Lights and Pawns in a file beside it. Move the Map into that folder in Finder, then open it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge öffnet Karten aus deinem Arbeitsbereich „%@“ und speichert die Wände, Lichter und Spielfiguren jeder Karte in einer Datei daneben. Verschiebe die Karte im Finder in diesen Ordner und öffne sie dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MapForge ανοίγει χάρτες μέσα από τον χώρο εργασίας σας, «%@», και κρατά τους τοίχους, τα φώτα και τα πιόνια κάθε χάρτη σε ένα αρχείο δίπλα του. Μετακινήστε τον χάρτη σε αυτόν τον φάκελο στο Finder και ανοίξτε τον ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge abre los mapas desde tu espacio de trabajo, «%@», y guarda los muros, las luces y las fichas de cada mapa en un archivo junto a él. Mueve el mapa a esa carpeta en el Finder y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge ouvre les cartes depuis votre espace de travail, « %@ », et conserve les murs, les lumières et les pions de chaque carte dans un fichier à côté d’elle. Déplacez la carte dans ce dossier dans le Finder, puis ouvrez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge apre le mappe dalla tua area di lavoro, “%@”, e conserva i muri, le luci e le pedine di ogni mappa in un file accanto a essa. Sposta la mappa in quella cartella nel Finder, poi aprila di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MapForge abre mapas de dentro do seu espaço de trabalho, “%@”, e guarda as paredes, as luzes e as peças de cada mapa em um arquivo ao lado dele. Mova o mapa para essa pasta no Finder e abra-o de novo."
          }
        }
      }
    },
    "MapForge will rename the damaged file to “parties.json.damaged” and start an empty roster. Nothing in it is deleted, so you can still open it yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge benennt die beschädigte Datei in „parties.json.damaged“ um und beginnt eine leere Gruppenliste. Ihr Inhalt wird nicht gelöscht, du kannst sie also weiterhin selbst öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MapForge θα μετονομάσει το κατεστραμμένο αρχείο σε «parties.json.damaged» και θα ξεκινήσει κενό κατάλογο. Τίποτα από το περιεχόμενό του δεν διαγράφεται, οπότε μπορείτε ακόμα να το ανοίξετε εσείς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge cambiará el nombre del archivo dañado a «parties.json.damaged» y empezará una lista vacía. No se elimina nada de su contenido, así que podrás seguir abriéndolo tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge renommera le fichier endommagé en « parties.json.damaged » et commencera une liste de groupes vide. Rien n’y est supprimé : vous pourrez toujours l’ouvrir vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge rinominerà il file danneggiato in “parties.json.damaged” e inizierà un elenco vuoto. Il suo contenuto non viene eliminato, quindi puoi ancora aprirlo tu stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MapForge vai renomear o arquivo danificado para “parties.json.damaged” e começar uma lista vazia. Nada nele é apagado, então você ainda pode abri-lo."
          }
        }
      }
    },
    "MapForge will use %@ the next time it opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge verwendet beim nächsten Start %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το MapForge θα χρησιμοποιήσει τη γλώσσα %@ την επόμενη φορά που θα ανοίξει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima vez que se abra, MapForge usará este idioma: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge utilisera %@ à sa prochaine ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MapForge userà %@ alla prossima apertura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MapForge vai usar %@ na próxima vez que for aberto."
          }
        }
      }
    },
