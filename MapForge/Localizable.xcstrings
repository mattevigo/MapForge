    "Drag a square over one grid square; arrow keys nudge (⇧ resizes).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe ein Quadrat über ein Rasterquadrat; Pfeiltasten verschieben es (⇧ ändert die Größe)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε ένα τετράγωνο πάνω σε ένα τετράγωνο του πλέγματος· τα πλήκτρα βέλους το μετακινούν λίγο (το ⇧ αλλάζει το μέγεθος)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un cuadrado sobre una casilla de la cuadrícula; las flechas lo desplazan (⇧ cambia el tamaño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un carré sur une case de la grille ; les flèches le décalent (⇧ redimensionne)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
