            "value": "Sistema"
          }
        }
      }
    },
    "Take out of the Order. Stays on the Map and can be put back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Reihenfolge nehmen. Bleibt auf der Karte und kann zurückgeholt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση από τη σειρά. Μένει στον χάρτη και μπορεί να επιστρέψει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacar del orden. Sigue en el mapa y se puede volver a poner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer de l’ordre. Reste sur la carte et peut y être réintégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli dall'ordine. Resta sulla mappa e si può reinserire in seguito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar da ordem. Continua no mapa e pode ser devolvida."
          }
        }
      }
    },
    "Temp": {
      "comment": "Temporary hit points, as narrow as the field",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temp"
          }
        },
        "el": {
