    "Solo Sight needs the Fog Overlay on — there is no darkness to shrink.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelsicht braucht den eingeschalteten Nebel — sonst gibt es keine Dunkelheit zu verkleinern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μεμονωμένη όραση χρειάζεται ενεργή ομίχλη — δεν υπάρχει σκοτάδι για να περιοριστεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La visión aislada necesita la niebla activada — no hay oscuridad que reducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vision isolée nécessite le brouillard — il n’y a aucune obscurité à réduire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista singola richiede la nebbia attiva — non c'è oscurità da ridurre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visão isolada precisa da névoa ligada — não há escuridão para reduzir."
          }
        }
      }
    },
    "Solo Sight. The table sees only what %@'s own light reaches. Click to end.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelsicht. Der Tisch sieht nur, was das eigene Licht von %@ erreicht. Klicke zum Beenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεμονωμένη όραση. Το τραπέζι βλέπει μόνο όσα φωτίζει το ίδιο το πιόνι %@. Κάντε κλικ για τέλος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visión aislada. La mesa solo ve hasta donde llega la luz de %@. Haz clic para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vision isolée. La table ne voit que ce qu’atteint la lumière de %@. Cliquez pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista singola. Il tavolo vede solo ciò che raggiunge la luce di %@. Fai clic per terminare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão isolada. A mesa vê apenas o que a luz de %@ alcança. Clique para encerrar."
          }
        }
      }
    },
    "Solo Sight: show the Map as %@ alone lights it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelsicht: die Karte so zeigen, wie %@ allein sie beleuchtet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεμονωμένη όραση: εμφάνιση του χάρτη όπως τον φωτίζει μόνο το πιόνι %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visión aislada: mostrar el mapa iluminado solo por %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vision isolée : montrer la carte éclairée par %@ uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista singola: mostra la mappa illuminata solo da %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visão isolada: mostrar o mapa como só %@ o ilumina."
          }
        }
      }
    },
