    "No Map open. Choose one with “Open Map…”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Karte geöffnet. Wähle eine mit „Karte öffnen …“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ανοιχτός χάρτης. Επιλέξτε έναν με «Άνοιγμα χάρτη…»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún mapa abierto. Elige uno con «Abrir mapa…»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune carte ouverte. Choisissez-en une avec « Ouvrir une carte… »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna mappa aperta. Scegline una con “Apri mappa…”."
          }
        },
        "pt-BR": {
