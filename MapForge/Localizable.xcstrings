    "Covers the Pawn on both screens, colour and label alike.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedeckt die Spielfigur auf beiden Bildschirmen, Farbe und Bezeichnung eingeschlossen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλύπτει το πιόνι και στις δύο οθόνες, μαζί με το χρώμα και την ετικέτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre la ficha en ambas pantallas, color y etiqueta incluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvre le pion sur les deux écrans, couleur et étiquette comprises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copre la pedina su entrambi gli schermi, colore ed etichetta compresi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobre a peça nas duas telas, cor e rótulo incluídos."
          }
        }
      }
    },
