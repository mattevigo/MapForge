    "Show Measurements on the Player Display. Off, the shape and its distance stay on this window only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messungen auf dem Spielerbildschirm zeigen. Ist dies aus, bleiben Form und Entfernung nur in diesem Fenster."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση μετρήσεων στην οθόνη παικτών. Όταν είναι ανενεργό, το σχήμα και η απόστασή του μένουν μόνο σε αυτό το παράθυρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar las medidas en la pantalla de jugadores. Si está desactivado, la forma y su distancia solo se ven en esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les mesures sur l’écran des joueurs. Désactivé, la forme et sa distance restent dans cette fenêtre uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le misure sullo schermo dei giocatori. Se disattivato, la forma e la sua distanza restano solo in questa finestra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as medidas na tela dos jogadores. Desligado, a forma e a distância ficam só nesta janela."
          }
        }
      }
    },
    "Show the rectangle the players see, and drag it to move their view.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rechteck zeigen, das die Spieler sehen, und durch Ziehen ihre Ansicht verschieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση του ορθογωνίου που βλέπουν οι παίκτες· σύρετέ το για να μετακινήσετε την προβολή τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el rectángulo que ven los jugadores y arrastrarlo para mover lo que ven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le rectangle que voient les joueurs, et le faire glisser pour déplacer leur vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il rettangolo che vedono i giocatori; trascinalo per spostare la loro visuale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o retângulo que os jogadores veem; arraste-o para mudar o que eles veem."
          }
        }
      }
    },
    "Show the whole Map on the Player Display, as large as it fits, ignoring the Grid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Karte so groß wie möglich auf dem Spielerbildschirm zeigen, ohne Rücksicht auf das Raster."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση ολόκληρου του χάρτη όσο το δυνατόν μεγαλύτερου στην οθόνη παικτών, αγνοώντας το πλέγμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el mapa entero lo más grande posible en la pantalla de jugadores, sin tener en cuenta la cuadrícula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher toute la carte aussi grande que possible sur l’écran des joueurs, sans tenir compte de la grille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l’intera mappa il più grande possibile sullo schermo dei giocatori, ignorando la griglia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o mapa inteiro o maior possível na tela dos jogadores, ignorando a grade."
          }
        }
      }
    },
