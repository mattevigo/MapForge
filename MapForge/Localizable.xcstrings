    "Could not read this Map's fog — its Walls and Lights are not shown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Nebel dieser Karte konnte nicht gelesen werden — ihre Wände und Lichter werden nicht angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση της ομίχλης αυτού του χάρτη — οι τοίχοι και τα φώτα του δεν εμφανίζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la niebla de este mapa — no se muestran sus muros ni sus luces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le brouillard de cette carte — ses murs et ses lumières ne sont pas affichés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la nebbia di questa mappa — i suoi muri e le sue luci non sono mostrati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a névoa deste mapa — as paredes e luzes dele não são mostradas."
          }
        }
      }
    },
    "Couldn't move your Parties": {
      "localizations": {
