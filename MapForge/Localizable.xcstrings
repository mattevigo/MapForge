    "%@: a Creature — emits no Light. Click to douse the light it does not cast.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: eine Kreatur — sendet kein Licht aus. Klicke, um das Licht auszumachen, das sie ohnehin nicht wirft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: πλάσμα — δεν εκπέμπει φως. Κάντε κλικ για να σβήσει το φως που δεν εκπέμπει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: una criatura — no emite luz. Haz clic para apagar la luz que no proyecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : une créature — n’émet aucune lumière. Cliquez pour éteindre la lumière qu’elle ne projette pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: una creatura — non emette luce. Fai clic per spegnere la luce che non proietta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: uma criatura — não emite luz. Clique para apagar a luz que não projeta."
          }
        }
      }
    },
