    "Go back to correct an earlier Turn. The Encounter does not rewind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehen, um einen früheren Zug zu korrigieren. Die Begegnung wird nicht zurückgespult."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστροφή για διόρθωση προηγούμενου Turn. Η συνάντηση δεν γυρίζει πίσω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver atrás para corregir un turno anterior. El encuentro no retrocede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir en arrière pour corriger un tour précédent. La rencontre ne recule pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna indietro per correggere un turno precedente. L'incontro non viene riavvolto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar para corrigir um turno anterior. O encontro não retrocede."
          }
        }
      }
    },
