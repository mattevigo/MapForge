    "Forget the Monster. The Stat Block keeps its numbers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monster vergessen. Der Wertekasten behält seine Werte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση του τέρατος. Το Stat Block κρατά τους αριθμούς του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar el monstruo. El perfil conserva sus números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier le monstre. Le profil garde ses valeurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica il mostro. La scheda delle statistiche mantiene i suoi valori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer o monstro. O bloco de estatísticas mantém os números."
          }
        }
      }
    },
    "Forget this note. The Character stamps no numbers until it has one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz vergessen. Der Charakter erhält keine Werte, bis er wieder eine hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεχάστε αυτή τη σημείωση. Ο χαρακτήρας δεν παίρνει αριθμούς μέχρι να αποκτήσει μία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar esta nota. El personaje no tendrá valores hasta que tenga una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier cette note. Le personnage n’a pas de valeurs tant qu’il n’en a pas une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica questa nota. Il personaggio non ha valori finché non ne ha una."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer esta nota. O personagem fica sem números até ter uma."
          }
        }
      }
    },
