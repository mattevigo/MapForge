    "No Grid declared, so these radii have no physical size yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Raster festgelegt, daher haben diese Radien noch keine physische Größe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει δηλωθεί πλέγμα, οπότε αυτές οι ακτίνες δεν έχουν ακόμα φυσικό μέγεθος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha declarado la cuadrícula, así que estos radios aún no tienen tamaño físico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune grille déclarée : ces rayons n’ont pas encore de taille physique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna griglia dichiarata: questi raggi non hanno ancora una dimensione fisica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma grade declarada, então estes raios ainda não têm tamanho físico."
          }
        }
      }
    },
    "No Grid declared, so this sight has no physical size yet.": {
      "localizations": {
