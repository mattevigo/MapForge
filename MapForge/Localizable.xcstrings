    "Initiative bonus: added to the d20 when Initiative is rolled. The rolled number is edited in the Order.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Initiativebonus: wird beim Würfeln der Initiative zum d20 addiert. Die gewürfelte Zahl wird in der Reihenfolge bearbeitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπόνους Initiative: προστίθεται στο d20 όταν ρίχνεται το Initiative. Το αποτέλεσμα της ρίψης διορθώνεται στη σειρά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonificador de iniciativa: se suma al d20 al tirar iniciativa. El número obtenido se edita en el orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus d’Initiative : ajouté au d20 lors du jet d’Initiative. Le résultat obtenu se modifie dans l’ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus di iniziativa: si somma al d20 quando si tira l'iniziativa. Il risultato del tiro si modifica nell'ordine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bônus de iniciativa: somado ao d20 quando a iniciativa é rolada. O número rolado é editado na ordem."
          }
        }
      }
    },
