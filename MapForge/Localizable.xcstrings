          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temp"
          }
        }
      }
    },
    "That folder couldn't be reached.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesen Ordner konnte nicht zugegriffen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η πρόσβαση σε αυτόν τον φάκελο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido acceder a esa carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est inaccessible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere quella cartella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar essa pasta."
          }
        }
      }
    },
    "That picture could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση της εικόνας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’immagine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a imagem."
          }
        }
      }
    },
    "That workspace couldn't be opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich konnte nicht geöffnet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα αυτού του χώρου εργασίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir ese espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir cet espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire quell'area di lavoro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esse espaço de trabalho."
          }
        }
      }
    },
    "The Combat Log is closed. Nobody is healed and no Condition is cleared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kampfprotokoll wird geschlossen. Niemand wird geheilt und kein Zustand aufgehoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο μάχης κλείνει. Κανείς δεν θεραπεύεται και κανένα Condition δεν αφαιρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de combate se cierra. Nadie se cura y no se elimina ningún estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal de combat est fermé. Personne n’est soigné et aucun état n’est retiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il log di combattimento viene chiuso. Nessuno viene curato e nessuna condizione viene rimossa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de combate é fechado. Ninguém é curado e nenhuma condição é removida."
          }
        }
      }
    },
    "The DM's own. Never drawn on the Player Display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die Spielleitung. Wird nie auf dem Spielerbildschirm angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο για τον DM. Δεν εμφανίζεται ποτέ στην οθόνη παικτών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para el DM. Nunca se muestra en la pantalla de jugadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propre au MJ. Jamais affiché sur l’écran des joueurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per il DM. Non viene mai mostrato sullo schermo dei giocatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só do mestre. Nunca aparece na tela dos jogadores."
          }
        }
      }
    },
    "The Order you have now is replaced. The Round stays where it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Reihenfolge wird ersetzt. Die Runde bleibt unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τρέχουσα σειρά αντικαθίσταται. Το Round μένει ως έχει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden actual se sustituye. El asalto sigue donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre actuel sera remplacé. Le round reste inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordine attuale viene sostituito. Il round resta invariato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ordem atual será substituída. A rodada continua onde está."
          }
        }
      }
    },
    "The folder your maps live in. MapForge keeps your parties and settings there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner mit deinen Karten. MapForge speichert dort deine Gruppen und Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο φάκελος όπου βρίσκονται οι χάρτες σας. Το MapForge κρατά εκεί τις ομάδες και τις ρυθμίσεις σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta donde están tus mapas. MapForge guarda ahí tus grupos y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier où se trouvent vos cartes. MapForge y conserve vos groupes et vos réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella in cui si trovano le tue mappe. MapForge vi conserva i tuoi gruppi e le tue impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta onde ficam seus mapas. O MapForge guarda ali seus grupos e ajustes."
          }
        }
      }
    },
    "The notes are read when the Workspace opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notizen werden beim Öffnen des Arbeitsbereichs gelesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις διαβάζονται όταν ανοίγει ο χώρος εργασίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas se leen al abrir el espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes sont lues à l’ouverture de l’espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note vengono lette all'apertura dell'area di lavoro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas são lidas quando o espaço de trabalho é aberto."
          }
        }
      }
    },
    "This Encounter's Combat Log could not be read — %@, %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kampfprotokoll dieser Begegnung konnte nicht gelesen werden — %1$@, %2$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του αρχείου μάχης αυτής της συνάντησης — %1$@, %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This Encounter's Combat Log could not be read — %1$@, %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el registro de combate de este encuentro — %1$@, %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le journal de combat de cette rencontre — %1$@, %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il log di combattimento di questo incontro — %1$@, %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o registro de combate deste encontro — %1$@, %2$@"
          }
        }
      }
    },
    "This Face came from %@. Every Pawn on this Map wearing it, and every Pawn that takes it later, can have the new cut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gesicht stammt von %@. Jede Spielfigur auf dieser Karte, die es trägt, und jede, die es später bekommt, kann den neuen Schnitt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το πρόσωπο προέρχεται από: %@. Κάθε πιόνι σε αυτόν τον χάρτη που το φέρει, και κάθε πιόνι που θα το πάρει αργότερα, μπορεί να πάρει τη νέα κοπή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rostro viene de %@. Cada ficha de este mapa que lo lleva, y cada ficha que lo tome después, puede recibir el nuevo recorte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce visage vient de %@. Chaque pion de cette carte qui le porte, et chaque pion qui le prendra ensuite, peut recevoir la nouvelle découpe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo volto viene da %@. Ogni pedina su questa mappa che lo porta, e ogni pedina che lo prenderà in seguito, può avere il nuovo ritaglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rosto vem de %@. Cada peça deste mapa que o usa, e cada peça que o receber depois, pode ficar com o novo recorte."
          }
        }
      }
    },
    "This Face came from %@. Every Treasure on this Map wearing it, and every Treasure that becomes it later, can have the new cut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gesicht stammt von %@. Jeder Schatz auf dieser Karte, der es trägt, und jeder, der später zu diesem Gegenstand wird, kann den neuen Schnitt erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το πρόσωπο προέρχεται από: %@. Κάθε θησαυρός σε αυτόν τον χάρτη που το φέρει, και κάθε θησαυρός που θα γίνει αυτό το αντικείμενο αργότερα, μπορεί να πάρει τη νέα κοπή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rostro viene de %@. Cada tesoro de este mapa que lo lleva, y cada tesoro que se convierta en ese objeto después, puede recibir el nuevo recorte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce visage vient de %@. Chaque trésor de cette carte qui le porte, et chaque trésor qui deviendra cet objet ensuite, peut recevoir la nouvelle découpe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo volto viene da %@. Ogni tesoro su questa mappa che lo porta, e ogni tesoro che diventerà quell'oggetto in seguito, può avere il nuovo ritaglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rosto vem de %@. Cada tesouro deste mapa que o usa, e cada tesouro que se tornar esse item depois, pode ficar com o novo recorte."
          }
        }
      }
    },
    "This Map isn't in your Workspace": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Karte ist nicht in deinem Arbeitsbereich"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο χάρτης δεν βρίσκεται στον χώρο εργασίας σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mapa no está en tu espacio de trabajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette carte n’est pas dans votre espace de travail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mappa non è nella tua area di lavoro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mapa não está no seu espaço de trabalho"
          }
        }
      }
    },
    "This Map's Grid has not been declared, so Light radii have no real size — run Grid Fit, or set the squares-wide value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Raster dieser Karte ist nicht festgelegt, daher haben Lichtradien keine echte Größe — verwende „Raster anpassen“ oder gib die Breite in Quadraten an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πλέγμα αυτού του χάρτη δεν έχει δηλωθεί, οπότε οι ακτίνες φωτός δεν έχουν πραγματικό μέγεθος — εκτελέστε Προσαρμογή πλέγματος ή ορίστε το πλάτος σε τετράγωνα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha declarado la cuadrícula de este mapa, así que los radios de luz no tienen tamaño real — usa Ajustar cuadrícula o indica el ancho en casillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La grille de cette carte n’a pas été déclarée : les rayons des lumières n’ont pas de taille réelle — utilisez Ajuster la grille ou indiquez la largeur en cases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La griglia di questa mappa non è stata dichiarata, quindi i raggi delle luci non hanno una dimensione reale — usa Adatta griglia o imposta la larghezza in quadretti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A grade deste mapa não foi declarada, então os raios de luz não têm tamanho real — use Ajustar grade ou defina a largura em quadrados."
          }
        }
      }
    },
    "This folder has a damaged MapForge workspace file. MapForge hasn't changed it. Move “.mapforge/workspace.json” aside to set the folder up again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner enthält eine beschädigte MapForge-Arbeitsbereichsdatei. MapForge hat sie nicht verändert. Verschiebe „.mapforge/workspace.json“ an einen anderen Ort, um den Ordner neu einzurichten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος έχει κατεστραμμένο αρχείο χώρου εργασίας του MapForge. Το MapForge δεν το έχει αλλάξει. Μετακινήστε αλλού το «.mapforge/workspace.json» για να ρυθμίσετε ξανά τον φάκελο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta tiene un archivo de espacio de trabajo de MapForge dañado. MapForge no lo ha modificado. Mueve «.mapforge/workspace.json» a otro sitio para volver a configurar la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier contient un fichier d’espace de travail MapForge endommagé. MapForge ne l’a pas modifié. Déplacez « .mapforge/workspace.json » ailleurs pour configurer à nouveau le dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella contiene un file dell'area di lavoro di MapForge danneggiato. MapForge non l'ha modificato. Sposta altrove “.mapforge/workspace.json” per configurare di nuovo la cartella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta tem um arquivo de espaço de trabalho do MapForge danificado. O MapForge não o alterou. Tire “.mapforge/workspace.json” do lugar para configurar a pasta de novo."
          }
        }
      }
    },
    "This folder isn't a MapForge workspace yet. MapForge will create a “.mapforge” folder inside it for your parties and settings.\n\nYour maps won't be changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist noch kein MapForge-Arbeitsbereich. MapForge erstellt darin einen Ordner „.mapforge“ für deine Gruppen und Einstellungen.\n\nDeine Karten werden nicht verändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο φάκελος δεν είναι ακόμα χώρος εργασίας του MapForge. Το MapForge θα δημιουργήσει μέσα του έναν φάκελο «.mapforge» για τις ομάδες και τις ρυθμίσεις σας.\n\nΟι χάρτες σας δεν θα αλλάξουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta aún no es un espacio de trabajo de MapForge. MapForge creará dentro una carpeta «.mapforge» para tus grupos y ajustes.\n\nTus mapas no se modificarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier n’est pas encore un espace de travail MapForge. MapForge y créera un dossier « .mapforge » pour vos groupes et vos réglages.\n\nVos cartes ne seront pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella non è ancora un'area di lavoro di MapForge. MapForge creerà al suo interno una cartella “.mapforge” per i tuoi gruppi e le tue impostazioni.\n\nLe tue mappe non verranno modificate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta ainda não é um espaço de trabalho do MapForge. O MapForge vai criar uma pasta “.mapforge” dentro dela para seus grupos e ajustes.\n\nSeus mapas não serão alterados."
          }
        }
      }
    },
    "This note gives distances in feet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz gibt Entfernungen in Fuß an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η σημείωση δίνει αποστάσεις σε πόδια."
