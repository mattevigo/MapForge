          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de esta noche se conserva. Al volver a empezar se abre uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal de ce soir est conservé. Redémarrer en ouvre un nouveau."
