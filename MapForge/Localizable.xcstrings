    "Hidden from players. Show it to see the Map through its eyes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor den Spielern verborgen. Zeige sie, um die Karte durch ihre Augen zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυφό από τους παίκτες. Εμφανίστε το για να δείτε τον χάρτη μέσα από τα μάτια του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta a los jugadores. Muéstrala para ver el mapa a través de sus ojos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masqué aux joueurs. Affichez-le pour voir la carte à travers ses yeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascosta ai giocatori. Mostrala per vedere la mappa con i suoi occhi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta dos jogadores. Mostre-a para ver o mapa pelos olhos dela."
          }
        }
      }
    },
    "Hidden from players. Still here, and still yours to move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor den Spielern verborgen. Noch da, und du kannst sie weiterhin bewegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυφό από τους παίκτες. Είναι ακόμα εδώ και μπορείτε να το μετακινήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta a los jugadores. Sigue aquí y puedes seguir moviéndola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masqué aux joueurs. Toujours là, et vous pouvez toujours le déplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascosta ai giocatori. È ancora qui e puoi ancora spostarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta dos jogadores. Continua aqui, e você ainda pode movê-la."
          }
        }
      }
    },
    "Hide or reveal the Fog Overlay on the Player Display. Pawns stay visible either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebel auf dem Spielerbildschirm ein- oder ausblenden. Spielfiguren bleiben in beiden Fällen sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψη ή εμφάνιση της ομίχλης στην οθόνη παικτών. Τα πιόνια παραμένουν ορατά σε κάθε περίπτωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar o mostrar la niebla en la pantalla de jugadores. Las fichas siguen visibles en ambos casos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer ou afficher le brouillard sur l’écran des joueurs. Les pions restent visibles dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi o mostra la nebbia sullo schermo dei giocatori. Le pedine restano comunque visibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta ou revela a névoa na tela dos jogadores. As peças continuam visíveis de qualquer forma."
          }
        }
      }
    },
    "High": {
      "comment": "An Encounter Difficulty band, as SRD 5.2.1 names it"
