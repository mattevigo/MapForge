    "Becoming a Monster means arriving whole: %@ becomes %@. Conditions and temporary hit points are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer zum Monster wird, kommt unversehrt an: Aus %1$@ wird %2$@. Zustände und temporäre Trefferpunkte bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετατροπή σε τέρας σημαίνει πλήρη αποκατάσταση: τα HP από %1$@ γίνονται %2$@. Τα Conditions και τα temporary hit points διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Becoming a Monster means arriving whole: %1$@ becomes %2$@. Conditions and temporary hit points are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertirse en monstruo significa llegar ileso: %1$@ pasa a ser %2$@. Se conservan los estados y los puntos de golpe temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devenir un monstre, c’est arriver indemne : %1$@ devient %2$@. Les états et les points de vie temporaires sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventare un mostro significa arrivare in piena forma: i punti ferita passano da %1$@ a %2$@. Le condizioni e i punti ferita temporanei restano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornar-se um monstro significa chegar inteiro: os pontos de vida passam de %1$@ para %2$@. As condições e os pontos de vida temporários são mantidos."
          }
        }
      }
    },
