    "“%@” has no note. Choose one with Edit… in the Party panel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat keine Notiz. Wähle eine mit Bearbeiten … im Bereich Gruppe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν έχει σημείωση. Επιλέξτε μία με Επεξεργασία… στο πλαίσιο Ομάδα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no tiene nota. Elige una con Editar… en el panel Grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’a pas de note. Choisissez-en une avec Modifier… dans le panneau Groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non ha una nota. Sceglila con Modifica… nel pannello Gruppo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não tem nota. Escolha uma com Editar… no painel Grupo."
          }
        }
      }
    },
    "“%@” is not in the Bestiary. Its numbers above are its own and are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht im Bestiarium. Die Werte oben gehören der Spielfigur und bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν υπάρχει στο θηριολόγιο. Οι αριθμοί του παραπάνω είναι δικοί του και δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no está en el bestiario. Sus números de arriba son propios y no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas dans le bestiaire. Les valeurs ci-dessus lui sont propres et restent inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è nel bestiario. I valori qui sopra sono i suoi e restano invariati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está no bestiário. Os números acima são próprios e não são afetados."
          }
        }
      }
    },
    "“%@” is not in the notes. Its numbers above are its own and are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht in den Notizen. Die Werte oben gehören der Spielfigur und bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν υπάρχει στις σημειώσεις. Οι αριθμοί του παραπάνω είναι δικοί του και δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no está en las notas. Sus números de arriba son propios y no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas dans les notes. Les valeurs ci-dessus lui sont propres et restent inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è tra le note. I valori qui sopra sono i suoi e restano invariati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não está nas notas. Os números acima são próprios e não são afetados."
          }
        }
      }
    },
